{#-
  cpp_operation.j2 — генерирует одно .hpp-определение для Operation.

  Вход:
    operation  — объект Operation (operations.py)

  Генерируемая структура:

    struct OperationName {
        static constexpr std::string_view method = "...";
        static constexpr std::string_view path   = "...";
        static constexpr std::string_view id     = "...";   // если задан

        struct param_<name> {
            static constexpr std::string_view name = "...";
            using location = cxxgen::param_location::<loc>;
            using schema   = <Type>;
            static constexpr bool required = true|false;
        };
        using parameters = cxxgen::typelist<param_foo, ...>;

        struct body_<ct_slug> {
            static constexpr std::string_view content_type = "...";
            using schema = <Type>;
        };
        using request_bodies = cxxgen::typelist<...>;

        struct response_<status> {
            using status_type = cxxgen::http_status<N>;
                              | cxxgen::default_response;
                              | cxxgen::status_range<"2XX">;

            struct header_<name> { ... };
            using headers = cxxgen::typelist<...>;

            struct body_<ct_slug> { ... };
            using bodies  = cxxgen::typelist<...>;
        };
        using responses = cxxgen::typelist<response_200, ...>;
    };
-#}
{%- set _path = operation | operation_output_path -%}
{{- set_output_path(_path) -}}
#pragma once
#include <cxxgen/common_types.hpp>
{% set ns   = cxxgen_ns() -%}
{%- set name = operation | cpp_operation_name -%}
{%- macro ct_slug(ct) -%}{{ ct | to_snake_case }}{%- endmacro -%}
{%- set responses = (operation.responses or []) -%}
{%- if operation.default_response -%}
{%-   set responses = responses + [operation.default_response] -%}
{%- endif %}

struct {{ name }} {
    static constexpr std::string_view method = "{{ operation.method }}";
    static constexpr std::string_view path   = "{{ operation.path }}";
{% if operation.id %}
    static constexpr std::string_view id     = "{{ operation.id }}";
{% endif %}
{%- if operation.meta %}
    // meta: {{ operation.meta }}
{%- endif %}

{#==================================================================
   Параметры
===================================================================#}
{%- if operation.parameters %}

    // ── parameters ───────────────────────────────────────────────
{%  for p in operation.parameters %}
{%      set pident = p.name | cpp_ident %}
{%      set ploc   = p.location.value if p.location is not none else "query" %}
{%      set preq   = (p.required is true) or (ploc == "path") %}
    struct param_{{ pident }} {
        static constexpr std::string_view name = "{{ p.name }}";
        using location = {{ ns }}::param_location::{{ ploc }};
        using schema   = {{ p.schema | cpp_type_for_ref }};
        static constexpr bool required = {{ "true" if preq else "false" }};
{%      if p.encoding %}
        static constexpr std::string_view encoding = "{{ p.encoding }}";
{%      endif %}
    };
{%  endfor %}
    using parameters = {{ ns }}::typelist<
{%  for p in operation.parameters %}
        param_{{ p.name | cpp_ident }}{{ "," if not loop.last else "" }}
{%  endfor %}
    >;
{%- endif %}

{#==================================================================
   Тела запроса
===================================================================#}
{%- if operation.bodies %}

    // ── request bodies ───────────────────────────────────────────
{%  for b in operation.bodies %}
    struct body_{{ ct_slug(b.content_type) }} {
        static constexpr std::string_view content_type = "{{ b.content_type }}";
        using schema = {{ b | cpp_body_type }};
{%      if b.streaming %}
        static constexpr bool streaming = true;
{%      endif %}
{%      if b.members_encoding %}
        // members_encoding: {{ b.members_encoding }}
{%      endif %}
    };
{%  endfor %}
    using request_bodies = {{ ns }}::typelist<
{%  for b in operation.bodies %}
        body_{{ ct_slug(b.content_type) }}{{ "," if not loop.last else "" }}
{%  endfor %}
    >;
{%- endif %}

{#==================================================================
   Ответы
===================================================================#}
{%- if responses %}

    // ── responses ────────────────────────────────────────────────
{%  for r in responses %}
{%      set rident  = r | cpp_status_ident %}
{%      set rstatus = r.status.to_string() if r.status is not none else "default" %}
    struct {{ rident }} {
{%      if r.status is not none and r.status.is_default() %}
        using status_type = {{ ns }}::default_response;
{%      elif rstatus | upper in ["1XX","2XX","3XX","4XX","5XX"] %}
        using status_type = {{ ns }}::status_range<"{{ rstatus }}">;
{%      else %}
        using status_type = {{ ns }}::http_status<{{ rstatus }}>;
{%      endif %}
{%      if r.headers %}

        // headers
{%          for h in r.headers %}
{%              set hident = "header_" ~ (h.name | cpp_ident) %}
        struct {{ hident }} {
            static constexpr std::string_view name = "{{ h.name }}";
{%              if h.schema %}
            using schema = {{ h.schema | cpp_type_for_ref }};
{%              endif %}
            static constexpr bool required = {{ "true" if h.required else "false" }};
        };
{%          endfor %}
        using headers = {{ ns }}::typelist<
{%          for h in r.headers %}
            header_{{ h.name | cpp_ident }}{{ "," if not loop.last else "" }}
{%          endfor %}
        >;
{%      endif %}
{%      if r.bodies %}

        // bodies
{%          for b in r.bodies %}
        struct body_{{ ct_slug(b.content_type) }} {
            static constexpr std::string_view content_type = "{{ b.content_type }}";
            using schema = {{ b | cpp_body_type }};
{%              if b.streaming %}
            static constexpr bool streaming = true;
{%              endif %}
        };
{%          endfor %}
        using bodies = {{ ns }}::typelist<
{%          for b in r.bodies %}
            body_{{ ct_slug(b.content_type) }}{{ "," if not loop.last else "" }}
{%          endfor %}
        >;
{%      endif %}
    };
{%  endfor %}

    using responses = {{ ns }}::typelist<
{%  for r in responses %}
        {{ r | cpp_status_ident }}{{ "," if not loop.last else "" }}
{%  endfor %}
    >;
{% endif %}
};
