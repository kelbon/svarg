
TAG(optimize, "enable optimizations")
STRING(passes, "list of additional optimization passes separated by whitespace. Allowed names: "
"rts - remove trivial schemas, rus - remove unused schemas, cf - combinators flatten, rur - remove useless requirements, ta - transform allofs, "
"aer - allof extract requirements",
 default(""))

ALIAS(O2, optimize)

DECLARE_STRING_ENUM(allow_remove_e, noone, only_inline_schemas, any)
OPTION(allow_remove_e, allow_remove, "which schemas optimization is allowed to remove", default("only_inline_schemas"))
RENAME(allow_remove, "allow-remove")

// openapi - спеки, ir - один файл с IR (вывод svarg-ir, json или yaml): к нему применяются только --passes
// (или -O2), без того, что фронтенд делает всегда
DECLARE_STRING_ENUM(input_format_e, openapi, ir)
OPTION(input_format_e, input_format, "format of input files: openapi specs or one IR file", default("openapi"))
RENAME(input_format, "input-format")

// если имя не указано и дефолтное "a" уже занято, берётся другое
STRING(out, "name of output file", default(""))
ALIAS(o, out)

STRING(out_format, "yaml or json", default("yaml"))
RENAME(out_format, "out-format")
ALIAS(f, out-format)

OPTION(std::string, specs_dir, "specs directory", default_value(std::filesystem::current_path().generic_string()))
RENAME(specs_dir, "specs-dir")
ALIAS(s, specs-dir)

BOOLEAN(unsetted_additional_properties, "if additional properties in object is not set, this means = true or fales?", default_value(false))
RENAME(unsetted_additional_properties, "unsetted-additional-properties")

// берёт на вход файлы, делает из них IR
ALLOW_ADDITIONAL_ARGS

ALIAS(h, help)
